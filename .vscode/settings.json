{
  "intl.nlsPath": ".cs/message_zh.js",
  "intl.identifier": [
    "intl",
    "intl.html",
    "intl.date"
  ],
  "ydMessage.localFilePath": "src/config/message.json",
  "ydMessage.preset": false,
  "editor.tabSize": 2,
  "editor.formatOnPaste": false,
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact"
  ],
  "tslint.enable": false,
  "javascript.validate.enable": false,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },
  "emmet.triggerExpansionOnTab": true,
  "editor.snippetSuggestions": "top",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.associations": {
    "*.html": "xml"
  },
}
